<div class="card m-3 border rounded bg-white col-lg-4  col-xl-3" >
    <div class="card-body d-flex flex-column justify-content-between">
       <div class="d-flex flex-wrap gap-3">


       <img src="/assets/img/{{job.logo | default('job_logo')}}" alt="{{ job.source | default('job_source')}}" class="logo">
       <div class="col-xxl" >
  
        <h4 class="card-title">
            {{ job.title  | default('job_title') | raw   }}
        </h4>
        <h5 class="card-title">
            {{ job.company | default('job_company') | raw  }}

        </h5>
    </div>
    </div> 
        <h6 class="card-subtitle mb-2 text-body-secondary">
            {{ job.location  | default('job_location' ) | raw }}
        </h6>
        <p>
            Publié le
            {{ (job.created ) | default('job_created')  }}
        </p>
        <p class="card-text">
            {{ job.description | default('job_description') | slice(0, 300) | raw }}
            ...
        </p>
        <p class="italic">
    <b>   {{ job.type_contrat | default('job_type_contrat') | raw }}</b> 
        </p>
        <div class="d-flex justify-content-end gap-2 align-items-center">

            {# <button class='d-block btn btn-link' onclick="newJob({{job|json_encode}})">
                Ajouter la candidature #}
            </button>
            <a class='d-block' href="{{ job.link | default('job_link') }}" target="_blank">
                Visualiser
            </a>

        </div>
    </div>
</div>
