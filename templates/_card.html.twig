<div class="card m-3 border rounded bg-white col-xxl-2 col-xl-3 col-lg-4 col-md-5 col-11">
  <div class="card-body d-flex flex-column justify-content-between">
    <h5 class="card-title">{{ job.recruiter|default('job_recruiter')|title }}</h5>
    <h6 class="card-subtitle mb-2 text-body-secondary">{{ job.title|default('job_title')|title }}</h6>
    <p class="card-text">{{ job.action_name|default('job_action_name') }}

      {{ job.delai|default('job_delai')|formatDelay }}</p>
    <p>{{ job.note_count|default('job_note_count') }}
      {{ job.note_count|default('job_note_count')|plural('postit', 'postits') }}</p>
    <p class="text-end">
      {% if job.delai is defined and job.delai < 0 %}
        <button class="btn cal" data-bs-toggle="tooltip" data-bs-title="Ajouter à votre calendrier Google" ><i class="fa-brands fa-google"  data-job="{{ job|json_encode }}" data-job-url="{{ path('app_job_tracking', { id: job.id|default('job_id') }) }}" data-target='ggogle'></i></button>
        <button class="btn cal"  data-bs-toggle="tooltip" data-bs-title="Ajouter à votre calendrier iCalc"><i class="fa-brands fa-apple"  data-job="{{ job|json_encode }}" data-job-url="{{ path('app_job_tracking', { id: job.id|default('job_id') }) }}" data-target="apple"></i></button>
      {% endif %}
      <a href="{{ path('app_job_tracking', { id: job.id|default('job_id') }) }}">Visualiser</a>
    </p>
  </div>
</div>
